# .gitignore와 겹치는 항목 위주 - 빌드 컨텍스트를 가볍게 유지하고,
# 로컬에만 있는 산출물이 이미지 안에 실수로 들어가는 걸 방지한다.
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
pytest-report.xml
*.egg-info/
build/
dist/
.venv/
venv/
*.ccproj
/out/
/output/
/photos/
/images/
.vscode/
.idea/
.DS_Store
