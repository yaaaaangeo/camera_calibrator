{
  "name": "camera_calibrator dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  // Dockerfile의 기본 ENTRYPOINT(python -m app.cli)는 CLI 배치 실행용이라,
  // 개발 컨테이너 안에서 셸을 그냥 열고 싶을 때는 덮어쓴다.
  "overrideCommand": true,

  "workspaceFolder": "/app",
  // 컨테이너 안에서 소스를 수정하면 호스트에도 바로 반영되게 bind mount로 연결
  // (Dockerfile의 COPY . .는 이미지 빌드 시점 스냅샷일 뿐이고, 개발 중에는
  // 이 마운트가 실제로 쓰인다).
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",

  "remoteEnv": {
    // 컨테이너 안엔 디스플레이가 없으므로 기본은 offscreen. GUI를 실제로
    // 띄우고 싶으면 이 값을 지우고 Dockerfile 하단 주석의 X11 포워딩 방법을 참고.
    "QT_QPA_PLATFORM": "offscreen"
  },

  // 컨테이너가 뜬 뒤 편집 가능한(editable) 설치로 한 번 더 맞춰서, 컨테이너
  // 안에서 코드를 고치면 camera-calibrator/camera-calibrator-cli 커맨드에도
  // 바로 반영되게 한다 (requirements-dev.txt는 이미 이미지 빌드 시 설치됨).
  "postCreateCommand": "pip install -e '.[dev]' --no-deps",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestArgs": ["tests"],
        "python.testing.pytestEnabled": true
      }
    }
  }
}
