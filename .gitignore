# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- 가상환경 ---
venv/
.venv/
env/
ENV/

# --- pytest / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
pytest-report.xml
coverage.xml

# --- 타입체커/린터 캐시 ---
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- 프로젝트 산출물 (README 6번: .ccproj는 사용자가 캘리브레이션마다
#     만드는 결과물이라 레포에 커밋할 게 아님. 예시/테스트용으로 일부러
#     넣고 싶으면 git add -f로 강제 추가 가능) ---
*.ccproj

# CLI/UI가 만드는 export 산출물(OpenCV/ROS YAML, HTML 리포트, JSON/CSV)도
# 기본적으로는 사용자 로컬 결과물이라 무시. 저장소에 예시로 넣고 싶으면
# 아래 패턴 대신 명시적으로 git add -f 사용.
/out/
/output/

# --- IDE / 에디터 ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- ROS bag 산출물 (테스트/실사용 중 로컬에 내려받는 대용량 파일) ---
*.bag
*.db3
*.mcap

# --- 캘리브레이션용 촬영 이미지 (사용자가 로컬에서 다루는 대용량 데이터) ---
# 레포 자체 샘플 이미지가 필요하면 tests/fixtures/ 같은 별도 경로를 쓰고
# 거기는 이 gitignore 규칙과 무관하게 명시적으로 추가할 것.
/photos/
/images/
